#!/bin/bash
# Publish the dashboard cache when main is pushed and the cache has changed.
#
# dashboard_cache.db is generated, ~12MB, and not in git -- it travels as a
# GitHub Release asset (see docs/publish.sh). Without this hook, publishing is a
# separate command you have to remember after every data update, and forgetting
# it means the server clones new results next to an old cache.
#
# WHO SHOULD INSTALL THIS: whoever publishes data updates -- one person. It is
# not for everyone on the team. Publishing needs the built cache and write access
# to the repository's releases, so for anyone else it can only fail, and a failed
# publish stops the push.
#
#     git config core.hooksPath docs/hooks
#
# That setting lives in .git/config, which is never committed, so cloning this
# repository does NOT switch the hook on -- teammates get an inert file. Keeping
# it in the repo rather than in .git/hooks is what lets it be reviewed and
# fixed. `git push --no-verify` skips it for a run.
#
# It does the deciding; docs/publish.sh does the work, so there is one
# implementation and running it by hand behaves identically.
set -euo pipefail

CACHE=web/data/dashboard_cache.db
STATE="$(git rev-parse --git-dir)/last-published-cache"

# Only for the branch the server deploys. There is a single cache-latest asset,
# so publishing from a feature branch would overwrite the cache main's deploy
# reads, and the next deploy of main would fail its freshness check with data
# nobody meant to ship.
DEPLOY_BRANCH=refs/heads/main

# git feeds the hook one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# Read it all now: publish.sh must not inherit a half-consumed stdin.
pushing_deploy_branch=no
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "$DEPLOY_BRANCH" ] && pushing_deploy_branch=yes
done

if [ "$pushing_deploy_branch" != yes ]; then
  exit 0
fi

if [ ! -f "$CACHE" ]; then
  echo "pre-push: $CACHE is missing; nothing to publish."
  echo "  If you meant to ship a data change, run: cd web && python -m app.jobs.build_all"
  exit 0
fi

# Is the precomputed data actually in step with Track.db? This catches the one
# mistake the rest of the hook cannot: committing a results change and pushing it
# without running build_all. The cache on disk is then unchanged, so the hash
# check below skips, nothing is published, and the first sign of trouble is the
# deploy aborting -- at the server, after a trip that has to be made twice.
#
# A warning rather than a refusal. The deploy gate is what actually stops a bad
# release, and blocking a template fix because the data is mid-rebuild would be
# out of proportion. This only makes sure it is said while it is still cheap to
# act on.
if ! ( cd web && python -m app.jobs.build_all --check >/dev/null 2>&1 ); then
  echo
  echo "pre-push: WARNING -- the precomputed data does not match web/data/Track.db."
  echo "  You have probably committed a results change without rebuilding."
  echo
  # `|| true` because --check exits non-zero by design here, and the script runs
  # under `set -e` with pipefail -- without it this warning would kill the hook
  # and block the push, which is the opposite of what it is for.
  ( cd web && python -m app.jobs.build_all --check 2>&1 | sed 's/^/    /' ) || true
  echo
  echo "  Fix before deploying:  cd web && python -m app.jobs.build_all"
  echo "  then commit and push again. Deploying now would abort on this."
  echo
fi

# Has the cache moved since it was last published? Without this every push --
# a typo in a template, a docs edit -- would re-upload 12MB for no reason.
current="$(sha256sum "$CACHE" | cut -d' ' -f1)"
if [ -f "$STATE" ] && [ "$current" = "$(cat "$STATE")" ]; then
  exit 0
fi

echo "pre-push: the dashboard cache has changed; publishing it to the release."

# stdin is redirected because git's ref list has already been consumed above and
# publish.sh must not read from it; --yes because there is no terminal to prompt
# at. publish.sh still refuses to publish a cache that does not match Track.db.
if ! ./docs/publish.sh --yes < /dev/null; then
  echo
  echo "pre-push: publishing the cache FAILED, so the push is stopped."
  echo "  Pushing now would put new results on GitHub beside an old cache, and"
  echo "  the next deploy would abort on the mismatch."
  echo
  echo "  Fix it and push again, or skip this check with:  git push --no-verify"
  exit 1
fi
